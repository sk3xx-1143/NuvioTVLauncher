<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ fix: SpeechRecognizer not available without this -->
    <!-- https://stackoverflow.com/questions/64319117/speechrecognizer-not-available-when-targeting-android-11 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <!-- Launcher: finds the system's Settings app, which the app lists leave out (the gear opens it). -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- Launcher: installed apps are listed through these, and the Home chooser needs the HOME query. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon Pack and Theme discovery on Android 11+ -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.dlto.atom.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.actionlauncher.THEME" />
        </intent>
        <intent>
            <action android:name="mobi.bbase.ahome.THEME" />
        </intent>
        <intent>
            <action android:name="com.sonymobile.home.ICON_PACK" />
        </intent>
        <intent>
            <action android:name="com.spocky.projengmenu.ACTION_THEME" />
        </intent>
        <intent>
            <action android:name="com.spocky.projengmenu.THEME" />
        </intent>
        <intent>
            <action android:name="com.spocky.projectivy.THEME" />
        </intent>
        <intent>
            <action android:name="com.spocky.projectivy.ICON_PACK" />
        </intent>
        <intent>
            <action android:name="com.projectivy.intent.action.ICON_PACK" />
        </intent>
        <intent>
            <action android:name="com.projectivy.theme.ICON_PACK" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Live TV fork: recordings keep running in the background (foreground service, awake, Wi-Fi on). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Live TV fork: scheduled recordings start on time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Android 13+: granted automatically (SCHEDULE_EXACT_ALARM isn't on Android 14+), so
         recordings start on time and can run in the background with the app closed. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".NuvioApplication"
        android:allowBackup="false"
        android:banner="@mipmap/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/Theme.MyApplication">
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />
        <meta-data
            android:name="io.sentry.tombstone.enable"
            android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Live TV fork: brings the launcher's home screen rows up to date (a new show, a new score). -->
        <receiver
            android:name=".livetv.home.LauncherRowsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nuvio.tv.livetv.LAUNCHER_ROWS" />
            </intent-filter>
        </receiver>

        <!-- Live TV fork: the pictures for the launcher's home screen rows. -->
        <provider
            android:name=".livetv.home.LauncherImageProvider"
            android:authorities="${applicationId}.launcherimg"
            android:exported="true" />

        <receiver
            android:name=".core.sync.androidtv.TvChannelBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.sync.androidtv.TvChannelRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Live TV fork: wakes the app for scheduled recordings, and sets them again after a restart. -->
        <receiver
            android:name=".livetv.record.RecordingAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nuvio.tv.livetv.RECORD" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Live TV fork: keeps recordings going while the app is in the background. -->
        <service
            android:name=".livetv.record.LiveTvRecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Launcher: brings the app up on the Home button when Android won't deliver it as the Home app,
             and re-enables itself after a reboot or update. Authorised by the user (or the phone setup). -->
        <receiver
            android:name=".core.launcher.LauncherBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.launcher.LauncherAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/launcher_accessibility_service_config" />
        </service>

        <service
            android:name=".core.notification.LauncherNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".core.player.ExternalPlaybackKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|layoutDirection|fontScale|locale"
            android:theme="@style/Theme.MyApplication.Launcher">
            <!-- Makes the app selectable as the device's Home app (same as FLauncher / ArcLauncher). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The remote's Apps button, when Android sends it to the Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="nuvio" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="stremio" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".launcher.AppIconDefault"
            android:banner="@mipmap/banner"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AppIconArcticBlue"
            android:banner="@mipmap/banner_arctic_blue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arctic_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AppIconEmerald"
            android:banner="@mipmap/banner_emerald"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emerald"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AppIconRoseGold"
            android:banner="@mipmap/banner_rose_gold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose_gold"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AppIconCopper"
            android:banner="@mipmap/banner_copper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_copper"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.AppIconGraphite"
            android:banner="@mipmap/banner_graphite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <profileable android:shell="true" />
    </application>

</manifest>
